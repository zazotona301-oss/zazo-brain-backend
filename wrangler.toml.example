# Example only: actual deployment IDs are configured in the repository's wrangler.toml.
# Do not put database passwords, Access secrets, or API tokens in this file.
name = "zazo-brain-backend"
main = "src/index.ts"
compatibility_date = "2026-10-21"
compatibility_flags = ["nodejs_compat"]

[observability]
enabled = true

[triggers]
crons = ["0 2 * * *"]

[[kv_namespaces]]
binding = "ACTIVE_CONTEXT"
id = "<ACTIVE_CONTEXT_KV_NAMESPACE_ID>"

[[kv_namespaces]]
binding = "ARCHIVE_STORE"
id = "<ARCHIVE_STORE_KV_NAMESPACE_ID>"

[[hyperdrive]]
binding = "HYPERDRIVE"
id = "<HYPERDRIVE_CONFIG_ID>"
